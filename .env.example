# ==============================================================================
# AI Research Assistant — Unified Environment Configuration
# ==============================================================================

# ── Frontend (Vercel) ────────────────────────────────────────────────────────
# Internal backend URL used by Next.js rewrites to proxy /api/v1 to the backend
BACKEND_INTERNAL_URL=https://ai-research-assistant-backend-j2sj.onrender.com/api/v1

# Public API Base URL: defaults to /api/v1 for the unified same-origin reverse proxy
NEXT_PUBLIC_API_BASE_URL=/api/v1

# ── Backend (Render / Python Server) ─────────────────────────────────────────
APP_NAME="AI Research Assistant"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Security (HS256 JWT)
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://ai-research-assistant-app-chi.vercel.app

# Database (SQLite for dev/single container, PostgreSQL for production scale)
DATABASE_URL=sqlite+aiosqlite:///aira_dev.db

# LLM Provider (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Embeddings & Vector Store
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=research_documents
ANONYMIZED_TELEMETRY=False

# Storage & Document Processing
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5

